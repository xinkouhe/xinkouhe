---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
}

const { title = site.title, description = site.description, eyebrow = 'xinkouhe / 心口合' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f2eee5" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={`${base}rss.xml`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="paper-grain" aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href={base} aria-label="回到 xinkouhe 首页">
          <span class="brand-mark">心</span>
          <span class="brand-name">xinkouhe</span>
        </a>
        <nav class="site-nav" aria-label="主要导航">
          {site.nav.map((item) => (
            <a href={`${base}${item.href}`} class:list={[{ active: item.href === '' ? Astro.url.pathname === base : Astro.url.pathname.startsWith(`${base}${item.href.replace('/', '')}`) }]}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="rss-link" href={`${base}rss.xml`} aria-label="订阅 RSS">RSS</a>
          <button class="theme-toggle" type="button" aria-label="切换深色模式" data-theme-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 15.9A8.5 8.5 0 0 1 8.1 3.4 8.5 8.5 0 1 0 20.6 15.9Z" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer shell">
      <div>
        <p class="footer-brand">心口合</p>
        <p class="footer-note">山高水长，来日方长。</p>
      </div>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} xinkouhe</span>
        <span class="footer-dot">·</span>
        <a href={`${base}rss.xml`}>订阅 RSS</a>
      </div>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('[data-theme-toggle]');
      const savedTheme = localStorage.getItem('xinkouhe-theme');
      if (savedTheme === 'dark') document.documentElement.dataset.theme = 'dark';
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        document.documentElement.dataset.theme = isDark ? 'light' : 'dark';
        localStorage.setItem('xinkouhe-theme', isDark ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
