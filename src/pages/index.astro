---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../data/site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<Layout>
  <section class="hero shell">
    <div class="hero-copy">
      <span class="hero-ornament" aria-hidden="true">山</span>
      <p class="eyebrow">A quiet corner on the web</p>
      <h1>心之所向<em>口自成章</em></h1>
      <p class="hero-intro">在喧囂世界裡，留一方清寂。<br />寫所見、所思，和那些尚未抵達的遠方。</p>
      <a class="text-link" href={`${base}posts/`}>閱覽文章</a>
    </div>
    <div class="ink-scene" aria-label="山水意境插畫">
      <div class="scene-frame">
        <div class="scene-sky"></div>
        <div class="moon"></div>
        <div class="mountain mountain-two"></div>
        <div class="mountain mountain-one"></div>
        <div class="mountain mountain-three"></div>
        <div class="mist"></div>
        <div class="pine"></div>
        <p class="scene-poem">行到水窮處<br />坐看雲起時</p>
        <span class="scene-seal">合</span>
      </div>
      <p class="scene-caption">雲深不知處 · 其一</p>
      <span class="scene-label">MOUNTAINS / 01</span>
    </div>
  </section>

  {featured && (
    <section class="featured-section shell">
      <div class="section-rule"><span>FEATURED NOTE</span></div>
      <div class="section-heading">
        <h2>近來所記</h2>
        <p>偶爾提筆，記下此刻。</p>
      </div>
      <article class="featured-card">
        <div class="featured-visual" aria-hidden="true"><span class="visual-chapter">CHAPTER 01 / 山水之間</span></div>
        <div class="featured-content">
          <p class="post-category">{featured.data.category}</p>
          <h3><a href={`${base}posts/${featured.id}/`}>{featured.data.title}</a></h3>
          <p class="excerpt">{featured.data.description}</p>
          <div class="post-meta"><time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time><span class="dot">·</span><span>{featured.data.readingTime} 閱讀</span></div>
        </div>
      </article>
    </section>
  )}

  <section class="lower-grid shell">
    <div>
      <div class="section-rule"><span>RECENT WRITINGS</span></div>
      <div class="recent-heading"><h2>新近文章</h2><a href={`${base}posts/`}>查看全部 →</a></div>
      <div class="post-list">
        {recent.map((post) => (
          <article class="post-row">
            <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10).replaceAll('-', '.')}</time>
            <div><h3><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
            <span class="post-arrow">↗</span>
          </article>
        ))}
      </div>
    </div>
    <aside class="about-card">
      <span class="quote-mark">“</span>
      <h2>關於這裡</h2>
      <p>這是 xinkouhe 的小小角落。收集靈感，也收集那些值得被記住的日常。</p>
      <a class="text-link" href={`${base}about/`}>認識我</a>
    </aside>
  </section>
</Layout>
